{
  "name": "@funniki/dsh-session-toolkit",
  "version": "0.1.0",
  "description": "Handier Session management for DeepSeek Harness: delete archived Sessions, move a Session to another Workspace, back up unsent composer text and images, search past messages by keyword (Chinese supported), and paste long text as a file. 会话功能增强五件套。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./components/dsh-archived-session-delete": "./components/dsh-archived-session-delete/lib/host.js",
    "./components/dsh-archived-session-delete/locale/en.json": "./components/dsh-archived-session-delete/locale/en.json",
    "./components/dsh-archived-session-delete/locale/zh.json": "./components/dsh-archived-session-delete/locale/zh.json",
    "./components/dsh-archived-session-delete/icon": "./components/dsh-archived-session-delete/icon.svg",
    "./components/dsh-session-move": "./components/dsh-session-move/lib/host.js",
    "./components/dsh-session-move/locale/en.json": "./components/dsh-session-move/locale/en.json",
    "./components/dsh-session-move/locale/zh.json": "./components/dsh-session-move/locale/zh.json",
    "./components/dsh-session-move/icon": "./components/dsh-session-move/icon.svg",
    "./components/dsh-unsent-content-guard": "./components/dsh-unsent-content-guard/lib/host-v106.js",
    "./components/dsh-unsent-content-guard/locale/en.json": "./components/dsh-unsent-content-guard/locale/en.json",
    "./components/dsh-unsent-content-guard/locale/zh.json": "./components/dsh-unsent-content-guard/locale/zh.json",
    "./components/dsh-unsent-content-guard/icon": "./components/dsh-unsent-content-guard/icon.svg",
    "./components/dsh-session-history-search": "./components/dsh-session-history-search/lib/host.js",
    "./components/dsh-session-history-search/locale/en.json": "./components/dsh-session-history-search/locale/en.json",
    "./components/dsh-session-history-search/locale/zh.json": "./components/dsh-session-history-search/locale/zh.json",
    "./components/dsh-session-history-search/icon": "./components/dsh-session-history-search/icon.svg",
    "./components/dsh-auto-paste": "./components/dsh-auto-paste/dist/index.js",
    "./components/dsh-auto-paste/locale/en.json": "./components/dsh-auto-paste/locale/en.json",
    "./components/dsh-auto-paste/locale/zh.json": "./components/dsh-auto-paste/locale/zh.json",
    "./components/dsh-auto-paste/icon": "./components/dsh-auto-paste/icon.svg"
  },
  "files": [
    "lib",
    "components",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "PACK-README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session"
  ]
}
