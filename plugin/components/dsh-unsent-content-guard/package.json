{
  "name": "dsh-unsent-content-guard",
  "version": "1.0.7",
  "private": true,
  "description": "Keeps a durable backup of unsent composer text and image drafts, removes a copy after a successful send, and restores unsent images a Session switch or a restart dropped.",
  "type": "module",
  "main": "lib/host-v106.js",
  "exports": {
    ".": "./lib/host-v106.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host-v106.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
