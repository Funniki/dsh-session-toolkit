{
  "name": "@funniki/dsh-session-toolkit",
  "version": "0.1.2-alpha1",
  "description": "Handier Session management: delete archived Sessions, move a Session to another Workspace, back up unsent composer text and images, and search past messages by keyword (Chinese supported).",
  "license": "MIT",
  "author": "funniki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funniki/dsh-session-toolkit.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "install.ps1",
    "locale/*.json",
    "icon.svg",
    "安装说明.md",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@funniki/dsh-session-toolkit-archived-session-delete": "0.1.2-alpha1",
    "@funniki/dsh-session-toolkit-auto-paste": "0.1.2-alpha1",
    "@funniki/dsh-session-toolkit-session-history-search": "0.1.2-alpha1",
    "@funniki/dsh-session-toolkit-session-move": "0.1.2-alpha1",
    "@funniki/dsh-session-toolkit-unsent-content-guard": "0.1.2-alpha1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
