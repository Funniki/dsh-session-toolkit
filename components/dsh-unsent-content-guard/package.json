{
  "name": "@funniki/dsh-session-toolkit-unsent-content-guard",
  "version": "0.1.5",
  "description": "Keeps a durable backup of unsent composer text and image drafts, removes a copy after a successful send, and restores unsent images a Session switch or a restart dropped.",
  "license": "MIT",
  "author": "funniki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funniki/dsh-session-toolkit.git"
  },
  "type": "module",
  "main": "lib/host-v106.js",
  "exports": {
    ".": "./lib/host-v106.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host-v106.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  }
}
