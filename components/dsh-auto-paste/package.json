{
  "name": "@funniki/dsh-session-toolkit-auto-paste",
  "version": "0.1.5",
  "description": "长文粘贴自动保存为工作区附件：按内容自动选择 .md 或 .txt，输入框只留一张带开头预览的引用卡片。零依赖重写版：宿主只 import node: 内置模块，浏览器端只 require react，不引入任何 @deepseek-ai 包。",
  "license": "MIT",
  "author": "funniki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funniki/dsh-session-toolkit.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "main": "./lib/host.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "lib/host.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "sessions",
        "connection"
      ]
    }
  }
}
