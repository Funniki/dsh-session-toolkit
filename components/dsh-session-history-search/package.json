{
  "name": "@funniki/dsh-session-toolkit-session-history-search",
  "version": "0.1.0",
  "description": "Keyword search across Session history messages, including Chinese substrings the built-in FTS index cannot match.",
  "license": "MIT",
  "author": "funniki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funniki/dsh-session-toolkit.git"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
