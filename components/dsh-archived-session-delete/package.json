{
  "name": "@funniki/dsh-session-toolkit-archived-session-delete",
  "version": "0.1.5",
  "description": "Delete archived Sessions from the sidebar: a red row hover button and a grouped Session-menu action, removing the stored Session log and its workspace accounting.",
  "license": "MIT",
  "author": "funniki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funniki/dsh-session-toolkit.git"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  }
}
